---
const { class: className, ...props } = Astro.props;
---

<section class:list={[className]} {...props}>
  <div id="player"></div>
  <video class="loading-img" autoplay loop muted src="img/loading.mp4"></video>
</section>

<style>
  :global(#player),
  .loading-img {
    width: 100%;

    @media (width < 960px) {
      height: min(56.25dvw, 43dvh);
    }

    @media (960px <= width) {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  .loading-img {
    position: absolute;
    top: 0;
    left: 0;
    background-color: #f9faef;
    transition: 0.7s;
    object-fit: contain;
  }
</style>
