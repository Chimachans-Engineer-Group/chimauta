---
interface Props {
  class?: string;
  id?: string;
  size?: number | string;
}

const { class: className, id, size = "1em" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  fill="currentColor"
  class:list={["bi", "bi-chevron-up", className]}
  id={id}
  viewBox="0 0 16 16"
>
  <path
    fill-rule="evenodd"
    d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708z"
  ></path>
</svg>
