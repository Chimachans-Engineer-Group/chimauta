---
import MessageSection from "../components/MessageSection.astro";
import PlayingBar from "../components/PlayingBar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SongTableSection from "../components/SongTableSection.astro";
import YoutubeSection from "../components/YoutubeSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <SiteHeader />

  <main>
    <YoutubeSection class="youtube-area" />
    <MessageSection class="message-area" />
    <SongTableSection class="song-table-area" />
  </main>

  <PlayingBar />
</BaseLayout>

<style>
  main {
    @media (width < 960px) {
      padding-bottom: 55px;
    }

    @media (960px <= width) {
      margin-top: var(--header-height);
      margin-bottom: 84px;
      display: grid;
      align-items: start;
      grid-template-rows: calc((100vw / 2.414 - 24px) / 16 * 9) auto;
      grid-template-columns: 1fr 1.414fr;
      padding: 16px;
      gap: 16px;
    }
  }

  @media (960px <= width) {
    .youtube-area {
      grid-row: 1 / 2;
      grid-column: 1 / 2;
    }

    .message-area {
      grid-row: 2 / 3;
      grid-column: 1 / 2;
    }

    .song-table-area {
      grid-row: 1 / 3;
      grid-column: 2 / 3;
    }
  }
</style>
